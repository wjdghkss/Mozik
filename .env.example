# Flask Web Server
FLASK_SECRET_KEY=change-this-secret-key
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
FLASK_DEBUG=false
BASE_URL=http://127.0.0.1:5000

# MariaDB
MYSQL_HOST=127.0.0.1
MYSQL_USER=mozik_user
MYSQL_PASSWORD=your_db_password
MYSQL_DB=mozik_db

# SMTP password reset mail. Optional.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@example.com
SMTP_PASSWORD=your_app_password
SMTP_SENDER=your_email@example.com

# Mosaic API endpoint. For local dummy route, keep 5000. For separated AI server, set FastAPI endpoint as needed.
MOSAIC_API_URL=http://127.0.0.1:5000/api/mosaic

# Optional YOLO model path
YOLO_MODEL_PATH=best.pt
